{
    "name": "mxnwire/laravel-audit-log",
    "description": "Audit log viewer layered on top of spatie/laravel-activitylog",
    "version": "2.0.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
        "spatie/laravel-activitylog": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Mxnwire\\AuditLog\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mxnwire\\AuditLog\\AuditLogServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "orchestra/testbench": "^8.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Mxnwire\\AuditLog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
